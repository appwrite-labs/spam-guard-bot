# Copy this file to .env and fill in the required values.
# Restart the bot after any change. See README.md for details on each setting.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Bot token from the Discord Developer Portal (Bot > Reset Token). Keep it secret.
DISCORD_TOKEN=

# Channel ID for moderation alerts (the audit log). Every automatic action
# posts an alert here. The bot only moderates the server this channel is in,
# and refuses to start if it cannot post here.
MODERATION_CHANNEL_ID=740463504602955806

# ---------------------------------------------------------------------------
# Optional channel
# ---------------------------------------------------------------------------

# Channel ID for detection feedback. When set, image and hiring-ad alerts get
# "False detection" / "Correct detection" buttons, and clicking one posts a copy
# of the case here. Can be the same channel as MODERATION_CHANNEL_ID.
# Leave empty to turn feedback off.
FEEDBACK_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Who is never checked
# ---------------------------------------------------------------------------

# Comma-separated role IDs. Members with any of these roles are skipped.
EXCLUDED_ROLE_IDS=564164014339391498,874574047910985750

# Skip the server owner and members with the Administrator permission.
EXCLUDE_ADMINS=true

# Also check messages from other bots. Webhooks are never checked.
MODERATE_BOTS=false

# ---------------------------------------------------------------------------
# Punishment
# ---------------------------------------------------------------------------

# Timeout length in minutes for every automatic action. Maximum 40320 (28 days).
# Kept short at launch so anyone caught by mistake is only muted briefly.
# Raise it (the built-in default is 1440, 24 hours) once alerts look right.
TIMEOUT_MINUTES=60

# ---------------------------------------------------------------------------
# Protections (true/false)
# ---------------------------------------------------------------------------

# Same message from one user in several channels within a short time.
ANTI_RAID_ENABLED=true
# high: 3+ channels in 2 min. medium: 4+ channels in 1 min. low: every text channel in 1 min.
ANTI_RAID_LEVEL=medium

# Known spam phrases (spam-messages.json), porn-related wording
# (spam-description-patterns.json; the word "NSFW" alone is allowed), and
# known spammer IDs (spam-users.json).
SPAM_MESSAGES_ENABLED=true

# Links to scam sites in blocked-domains.json, in text or inside images.
BLOCKED_LINKS_ENABLED=true

# Invites to servers listed in malicious-servers.json, in text or inside images.
MALICIOUS_INVITES_ENABLED=true

# Invites to age-restricted servers or servers named after nsfw-server-keywords.json.
NSFW_INVITES_ENABLED=true

# Hiring and recruitment ads ("We're hiring a React developer, DM me").
TEXT_SCAM_ENABLED=true

# ---------------------------------------------------------------------------
# Image scanning
# ---------------------------------------------------------------------------

# How much scam text an image needs before the bot acts:
#   low:     only blocked links or invites in the image
#   medium:  "Withdrawal" + "Success" + "USDT"
#   high:    "Withdrawal" + ("Success" or "USDT")
#   extreme: any single word such as "money", "bonus", or "casino"
# Matches against known scam images in visual-references/ apply at every level.
IMAGE_SCAN_SENSITIVITY=high

# How closely an image must match a known scam image: how many of 64
# fingerprint points may differ. Lower is stricter; 0 means near-identical.
VISUAL_MATCH_THRESHOLD=6

# Images larger than this are skipped, not scanned.
MAX_IMAGE_SIZE_MB=8

# Images with more pixels than this are skipped.
MAX_IMAGE_PIXELS=16000000

# Give up downloading an image after this many milliseconds.
IMAGE_DOWNLOAD_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# !spamreport command (off by default)
# ---------------------------------------------------------------------------

# A moderator replies "!spamreport" to a message: the author is timed out and
# identical messages from them are deleted across all channels.
SPAM_REPORT_ENABLED=false

# Timeout length in minutes for reported users.
SPAM_REPORT_TIMEOUT_MINUTES=10

# How far back, in minutes, to look for identical messages. Each 100 messages
# scanned per channel costs one Discord API request.
SPAM_REPORT_LOOKBACK_MINUTES=60
