{
  "name": "spam-guard-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord bot that removes scam images, scam links, and spam from a Discord server.",
  "type": "module",
  "main": "src/index.js",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build:visual-references": "node scripts/build-visual-reference-manifest.mjs",
    "prestart": "pnpm build:visual-references",
    "start": "node src/index.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "onnxruntime-node": "^1.30.0",
    "ppu-paddle-ocr": "^6.6.0",
    "sharp": "^0.35.4"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=6.28.0 <7"
    }
  }
}
